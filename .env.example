# ==============================================================================
# Hurion Bot Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env and configure the variables for your environment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Discord Bot Credentials (REQUIRED for live bot operation)
# ------------------------------------------------------------------------------
# Your Discord Bot Token obtained from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_actual_discord_bot_token_here

# ------------------------------------------------------------------------------
# 2. Database Configuration (OPTIONAL)
# ------------------------------------------------------------------------------
# Path to the SQLite database file.
# Default (Local): ./data/db.sqlite
# Default (Docker): /hurion/data/db.sqlite
# DB_PATH=./data/db.sqlite

# ------------------------------------------------------------------------------
# 3. Azure Blob Storage & Litestream Replication (OPTIONAL)
# ------------------------------------------------------------------------------
# Configure these variables to enable real-time SQLite database replication
# (via Litestream) and cloud JSON scoreboard uploads to Azure Blob Storage.
# If omitted, Litestream defaults to local file backups (/hurion/local-backups)
# and the Scoreboard Exporter defaults to local disk writes (./data/exports).

# Azure Storage Account Name
# AZURE_STORAGE_ACCOUNT=your_azure_storage_account_name

# Azure Storage Account Access Key (Used by Scoreboard Exporter & Litestream)
# AZURE_STORAGE_KEY=your_azure_storage_account_key

# Litestream-specific Azure Access Key (Used by Litestream for DB replication)
# LITESTREAM_AZURE_ACCOUNT_KEY=your_azure_storage_account_key

# Azure Blob Storage Container Name
# Default: exports
# AZURE_STORAGE_CONTAINER=exports

# Optional: Full Azure Blob Storage Connection String (Overrides Account & Key if set)
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

# ------------------------------------------------------------------------------
# 4. Discord Bot Web UI Link Configuration (RECOMMENDED)
# ------------------------------------------------------------------------------
# Base URL used by Discord embeds to link to the Web UI (`!score`)
# WEB_UI_BASE_URL=https://<your-app-name>.azurestaticapps.net

# ------------------------------------------------------------------------------
# 5. Frontend Web UI - Client Vite Configuration (OPTIONAL)
# ------------------------------------------------------------------------------
# Base URL for fetching exported scoreboard JSON files in the browser.
# Default (Local): /exports (Leave unset for local Go development)
# Production (Azure Blob Storage): https://<your-storage-account>.blob.core.windows.net/exports
# VITE_EXPORTS_BASE_URL=https://<your-storage-account>.blob.core.windows.net/exports
