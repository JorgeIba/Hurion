    "react-router": "^8.4.0",
    "use-debounce": "^10.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "^20.12.12",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vitest": "^2.1.9"
  }
